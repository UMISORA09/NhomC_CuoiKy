# WordPress Git Ignore
# Ignore uploads & cache to prevent large binary files in git
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backup-db/
wp-content/backups/

# Ignore local configuration files with sensitive credentials
wp-config.php
.env

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
